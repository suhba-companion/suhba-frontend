{
  "expo": {
    "name": "Suhba",
    "slug": "suhba",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "suhba",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFFFFF",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "at.suhba.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Suhba zeigt dir die Entfernung zu Gebetsorten und Events in deiner Nähe. Ohne Standort rechnet die App ab Wien-Mitte."
      },
      "privacyManifests": {
        "NSPrivacyCollectedDataTypes": [
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypePreciseLocation",
            "NSPrivacyCollectedDataTypeLinked": false,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "at.suhba.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Amiri-Regular.ttf",
            "./assets/fonts/Amiri-Bold.ttf",
            "./assets/fonts/Amiri-Italic.ttf"
          ]
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Suhba zeigt dir die Entfernung zu Gebetsorten und Events in deiner Nähe. Ohne Standort rechnet die App ab Wien-Mitte.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "locationFullAccuracyPermission": false,
          "motionUsagePermission": false
        }
      ],
      "@react-native-community/datetimepicker",
      "./plugins/withForceLightTheme",
      "./plugins/withoutOverlayPermission",
      "expo-status-bar"
    ],
    "platforms": [
      "ios",
      "android"
    ],
    "extra": {
      "eas": {
        "projectId": "63e1641c-b296-4947-b703-4994c74481a7"
      }
    },
    "owner": "suhba-companion"
  }
}
