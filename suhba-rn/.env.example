# Backend origin. `/api/v1` is appended in src/config.ts.
# Leave unset and the app falls back to http://localhost:8080.
#
# This is the only variable the app reads. The basemap is MapKit on iOS and Google Maps
# on Android via react-native-maps, and addresses are geocoded by the platform's own
# geocoder — none of which takes a key.
EXPO_PUBLIC_API_BASE_URL=https://suhba-backend.onrender.com
